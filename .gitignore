# 依赖与构建产物
node_modules/
dist/
dist-demo/
*.tsbuildinfo
*.tgz

# 构建 / 打包时的临时目录（沙箱环境下 TMP 指向此处）
.tmp-build/

# pdf.js 运行时资源：体积较大，由 npm run assets 生成，不入库
public/pdfjs/

# 运行时产生的临时 PDF（调试 / 预览时的随机名文件）
public/samples/[0-9a-f]{32}.pdf

# 验证脚本的输出（截图与报告，非交付物）
screenshots/
debug-*.png
debug-*.mjs

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/